<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ooyala.flex</groupId>
  <artifactId>using-an-ide-to-write-scripts</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <!-- Java version used to compile this project. Select the same JDK for the project and Maven in your IDE. -->
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Character encoding used when Maven reads and compiles source files. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Version of the public Flex SDK that provides code completion for Flex classes and methods. -->
    <!-- Tip: use Confluence "Flex Release / Update Notes" page to find the SDK version for your Flex version. -->
    <flex-sdk.version>12.13.2-2-g2b3bb87-PR-654</flex-sdk.version>

    <!-- JUnit and Mockito are used only to run the example unit test. -->
    <junit-jupiter.version>5.12.2</junit-jupiter.version>
    <mockito.version>5.23.0</mockito.version>
  </properties>

  <dependencies>
    <!-- Flex dependencies -->
    <dependency>
      <groupId>com.ooyala.flex</groupId>
      <artifactId>flex-sdk-external</artifactId>
      <version>${flex-sdk.version}</version>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- IntelliJ's Maven importer recognises build-helper as a source-contributing plugin. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-groovy-sources</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/main/groovy</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-groovy-test-sources</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/test/groovy</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <version>4.3.1</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compileTests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
